#!/bin/bash

VERSION="1.2.0"
SYSTEM_LIB_DIR="./lib"

if [[ "$SYSTEM_LIB_DIR" == "./lib" ]]; then
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    LIB_DIR="$SCRIPT_DIR/lib"
else
    LIB_DIR="$SYSTEM_LIB_DIR"
fi

if [[ -f "$LIB_DIR/core.bash" ]]; then
    source "$LIB_DIR/core.bash"
else
    echo "Fatal Error: Missing core module at $LIB_DIR/core.bash"
    exit 1
fi

for module in "$LIB_DIR"/*.bash; do
    [[ "$module" == *"/core.bash" ]] && continue
    source "$module"
done

usage() {
    echo "Usage: $(basename "$0") <command> [arguments]"
    echo ""
    echo "Commands:"
    echo "  search <query>                  Search packages on AUR"
    echo "  add <name> <url>                Add or update a repository in memory"
    echo "  remove <name>                   Remove a repository from memory"
    echo "  uninstall <name>                Uninstall the software from the system"
    echo "  list                            Show all saved repositories and versions"
    echo "  view <name>                     Read the PKGBUILD of a saved package"
    echo "  log <name>                      Show commit history for downgrade purposes"
    echo "  install [name|--all] [--upgrade] Clone, compile and optionally upgrade"
    echo "  check                           Check for updates and refresh version data"
    echo "  import [--all]                  Import already installed AUR packages"
}

main() {
    init_core

    case "$1" in
        search) shift; search_aur "$@" ;;
        add) shift; add_repo "$@" ;;
        remove) shift; remove_repo "$@" ;;
        uninstall) shift; uninstall_pkg "$@" ;;
        list) list_repos ;;
        view) shift; view_pkgbuild "$@" ;;
        log) shift; log_repo "$@" ;;
        install) shift; install_repos "$@" ;;
        check) check_updates ;;
        import) shift; import_repos "$@" ;;
        *) usage ;;
    esac
}

main "$@"